:{$PORT}

root * /Website/
file_server

# Only serve index.html normally
@html_index { path /index.html }
header @html_index Content-Type "text/html; charset=utf-8"
header @html_index Cache-Control "public, max-age=3600"

# All SDK assets are binary and never cached
@sdk_assets { not path /index.html }
header @sdk_assets Content-Type application/octet-stream
header @sdk_assets Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"

# Security headers for everything
header {
    Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: * blob:; connect-src 'self' https: * blob:; media-src 'self' https: * blob:; font-src 'self' data: https: *; object-src 'none'; frame-src 'self' https: * blob:;"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
}